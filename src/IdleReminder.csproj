<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion><UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode><ApplicationManifest>app.manifest</ApplicationManifest><NeutralLanguage>zh-Hans</NeutralLanguage><Version>0.0.2.0</Version><AssemblyVersion>0.0.2.0</AssemblyVersion><FileVersion>0.0.2.0</FileVersion><InformationalVersion>0.0.2.0</InformationalVersion><IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion><ApplicationIcon>..\assets\icons\app.ico</ApplicationIcon></PropertyGroup>
<ItemGroup><Content Include="..\docs\UserGuide.zh-Hans.html;..\docs\UserGuide.en.html;..\docs\UserGuide.zh-Hans.txt;..\docs\UserGuide.en.txt" Link="docs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /><Content Include="..\ICON-LICENSE.md" Link="ICON-LICENSE.md" CopyToOutputDirectory="PreserveNewest" /><Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" /><Content Include="..\LICENSE_SCOPE.md" Link="LICENSE_SCOPE.md" CopyToOutputDirectory="PreserveNewest" /><Content Include="..\licenses\*" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /><Content Include="..\assets\tone?.wav" Link="assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /><Content Include="..\更新日志.txt" Link="更新日志.txt" CopyToOutputDirectory="PreserveNewest" /><Content Include="..\PHONE_NOTIFICATIONS.md" Link="PHONE_NOTIFICATIONS.md" CopyToOutputDirectory="PreserveNewest" /><Content Include="..\ICON_PREPARATION.md" Link="ICON_PREPARATION.md" CopyToOutputDirectory="PreserveNewest" /><EmbeddedResource Include="..\assets\icons\app.ico" LogicalName="IdleReminder.Icons.App.ico"/><EmbeddedResource Include="..\assets\icons\tray.ico" LogicalName="IdleReminder.Icons.Tray.ico"/></ItemGroup>
<Target Name="BuildUserGuides" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
  <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\docs\GuideBuilder\GuideBuilder.csproj&quot; --configuration Release --no-launch-profile -- &quot;$(MSBuildProjectDirectory)\..\docs&quot; &quot;$(Version)&quot;" />
</Target>
</Project>




















